# ================================================================
# DentiSoft 1.0 - Configuracion de Entorno
# ================================================================

# Copia este archivo como .env y completa tus valores reales.
# No compartas el archivo .env ni credenciales SMTP.

# URL publica opcional para enlaces dentro de correos.
# Ejemplo local: http://localhost
APP_PUBLIC_URL=http://localhost

# ================================================================
# DATABASE - CONFIGURACION MYSQL
# ================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=odonto_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ================================================================
# MAIL - CONFIGURACION SMTP
# ================================================================

# Mantener false hasta configurar credenciales reales.
MAIL_ENABLED=false

# Gmail: smtp.gmail.com / 465 / ssl
# Outlook: smtp-mail.outlook.com / 587 / tls
# Mailtrap: sandbox.smtp.mailtrap.io / 2525 / tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl

# Credenciales reales del proveedor SMTP.
MAIL_USERNAME=
MAIL_PASSWORD=

# Remitente visible para el paciente. Si queda vacio, se usa MAIL_USERNAME.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="DentiSoft Odontologia"

# Opcional: si se define, todos los correos saldran a esta direccion.
MAIL_TEST_EMAIL=

# Solo para diagnostico local.
MAIL_DEBUG=false
