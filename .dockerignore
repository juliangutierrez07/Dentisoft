.env.local
.env.*.local

# Runtime / cache / logs locales
storage/logs/*
storage/cache/*
storage/sessions/*
storage/backups/*
runtime_sessions/
sess_*
*.log
*.tmp

# Uploads locales (datos de pacientes de la máquina de desarrollo)
assets/uploads/fotos/*
assets/uploads/radiografias/*
storage/uploads/*

# Herramientas / IDE
.vscode/
.idea/
.DS_Store
node_modules/
tests/manual/
